<Application x:Class="Dispatch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Dispatch.App.Converters"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <!-- ThemeMode="System" uses WPF's built-in Fluent theme and follows Windows' light/dark setting. -->
    <Application.Resources>
        <c:CompatToBrushConverter x:Key="CompatToBrush" />
        <c:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <c:PathToImageConverter x:Key="PathToImage" />
        <c:VisibleWhenConverter x:Key="VisibleWhen" />
        <c:NotConverter x:Key="Not" />
        <c:BoolToBrushConverter x:Key="BoolToBrush" />

        <!-- A small coloured pill used for compatibility and "not installed" badges. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,6,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBox">
            <!-- Read-only, selectable text: lets you copy paths and names. -->
            <Setter Property="IsReadOnly" Value="True" />
            <!-- Fluent dims read-only boxes; use the normal text colour so values stay readable. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Application.Resources>
</Application>
