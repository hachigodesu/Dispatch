<Application x:Class="Dispatch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Dispatch.App.Converters"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <!-- ThemeMode="System" uses WPF's built-in Fluent theme and follows Windows' light/dark setting. -->
    <Application.Resources>
        <c:CompatToBrushConverter x:Key="CompatToBrush" />
        <c:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <c:PathToImageConverter x:Key="PathToImage" />
        <c:VisibleWhenConverter x:Key="VisibleWhen" />
        <c:RatioConverter x:Key="Ratio" />
        <c:NotConverter x:Key="Not" />
        <c:BoolToBrushConverter x:Key="BoolToBrush" />

        <!-- A small coloured pill used for compatibility and "not installed" badges. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,6,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBox">
            <!-- Read-only, selectable text: lets you copy paths and names. -->
            <Setter Property="IsReadOnly" Value="True" />
            <!-- Fluent dims read-only boxes; use the normal text colour so values stay readable. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- A drag handle between two side-by-side areas: put it in its own Auto column between them. It shows a thin
             grip line that lights up on hover and while dragging. -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Grip" Width="2" RadiusX="1" RadiusY="1" Margin="0,24" Fill="#30808080" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Fill" Value="#A00078D4" />
                                <Setter TargetName="Grip" Property="Width" Value="3" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Fill" Value="#FF0078D4" />
                                <Setter TargetName="Grip" Property="Width" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
