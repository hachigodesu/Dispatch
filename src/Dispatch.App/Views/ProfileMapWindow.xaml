<Window x:Class="Dispatch.App.Views.ProfileMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Dispatch.App.Resources"
        xmlns:v="clr-namespace:Dispatch.App.Views"
        xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ProfileMapViewModel}"
        Title="{Binding Title}" Width="1280" Height="860" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6" />
            <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:MapNote">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#C25A00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.MapClose}" IsCancel="True" MinWidth="88" Click="OnClose" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.MapWholeMap}" Click="OnZoomAll" Margin="0,0,8,0"
                    Visibility="{Binding HasMap, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{x:Static res:Strings.ProfileMapHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <v:MapCanvas x:Name="Map" Scene="{Binding Scene}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320"
                                Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,8" />
                        <ProgressBar Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}" Height="6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Legend: one row per mod that changes the map, top of the load order first, the game last. -->
            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{x:Static res:Strings.LegendHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasMap, Converter={StaticResource VisibleWhen}}">
                    <Button Content="{x:Static res:Strings.LegendShowAll}" Command="{Binding ShowAllCommand}" Margin="0,0,6,0" />
                    <Button Content="{x:Static res:Strings.LegendModsOnly}" Command="{Binding ModsOnlyCommand}" />
                </WrapPanel>
                <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Legend}" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ProfileMapLegendItem">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRoads}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Top" Margin="0,2,0,0" MinWidth="0"
                                                  IsEnabled="{Binding HasRoads}" ToolTip="{x:Static res:Strings.LegendToggle}" />
                                        <Border Grid.Column="1" Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                                                VerticalAlignment="Top" Margin="2,8,8,0" />
                                        <StackPanel Grid.Column="2">
                                            <Button Click="OnZoomToItem" IsEnabled="{Binding CanZoom}" HorizontalAlignment="Left"
                                                    HorizontalContentAlignment="Left" Padding="2,1" Background="Transparent" BorderThickness="0"
                                                    ToolTip="{x:Static res:Strings.LegendZoom}">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            </Button>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
