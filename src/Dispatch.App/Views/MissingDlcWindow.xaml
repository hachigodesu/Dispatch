<Window x:Class="Dispatch.App.Views.MissingDlcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Dispatch.App.Resources"
        xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MissingDlcViewModel}"
        Title="{x:Static res:Strings.MissingDlcTitle}" Width="620" Height="460" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.MissingDlcExplain}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.MissingDlcLaunchAnyway}" Click="OnLaunch" MinWidth="120" Margin="0,0,8,0" />
            <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" IsDefault="True" MinWidth="88" Style="{StaticResource AccentButtonStyle}" />
        </WrapPanel>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="10,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MissingDlcRow">
                            <StackPanel Margin="0,4">
                                <Border Style="{StaticResource Badge}" Background="#C62828">
                                    <TextBlock Text="{Binding Dlc}" Style="{StaticResource BadgeText}" />
                                </Border>
                                <TextBlock Text="{Binding Mods}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="2,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
