<UserControl x:Class="Dispatch.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Dispatch.App.Resources"
             xmlns:v="clr-namespace:Dispatch.App.Views"
             xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModsViewModel}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,12,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static res:Strings.SearchMods}" />
                <!-- Placeholder: WPF's TextBox has none built in, so overlay a hint while the box is empty. -->
                <TextBlock Text="{x:Static res:Strings.SearchMods}" IsHitTestVisible="False" Margin="12,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource Muted}"
                           Visibility="{Binding Text, ElementName=Search, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ModItemViewModel">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="64" Height="38" Stretch="Uniform" HorizontalAlignment="Left"
                                   Source="{Binding IconFile, Converter={StaticResource PathToImage}, ConverterParameter=128}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ListSubtitle}" Style="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Badge}"
                                    Background="{Binding CompatStatus, Converter={StaticResource CompatToBrush}}">
                                <TextBlock Text="{Binding CompatLabel}" Style="{StaticResource BadgeText}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <v:ModDetailsView Grid.Column="1" DataContext="{Binding Selected}" />
    </Grid>
</UserControl>
