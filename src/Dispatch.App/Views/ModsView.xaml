<UserControl x:Class="Dispatch.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="clr-namespace:Dispatch.App.Behaviors"
             xmlns:res="clr-namespace:Dispatch.App.Resources"
             xmlns:v="clr-namespace:Dispatch.App.Views"
             xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModsViewModel}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,12,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static res:Strings.SearchMods}" />
                <!-- Placeholder: WPF's TextBox has none built in, so overlay a hint while the box is empty. -->
                <TextBlock Text="{x:Static res:Strings.SearchMods}" IsHitTestVisible="False" Margin="12,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource Muted}"
                           Visibility="{Binding Text, ElementName=Search, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}" Margin="8,0,0,0" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding ShowOptions}" SelectedItem="{Binding Show}" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Content="{x:Static res:Strings.InstallMods}" Command="{Binding InstallCommand}" Margin="0,0,6,0" />
                <Button Content="{x:Static res:Strings.UninstallMods}" Command="{Binding UninstallCommand}" Margin="0,0,12,0" />
                <TextBlock Text="{x:Static res:Strings.DropHint}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Content="{x:Static res:Strings.LibraryMoveUnused}" Command="{Binding MoveUnusedToLibraryCommand}" Margin="0,0,6,0"
                        ToolTip="{x:Static res:Strings.LibraryHint}" />
                <Button Content="{x:Static res:Strings.LibraryMoveAllBack}" Command="{Binding MoveAllBackCommand}" Margin="0,0,6,0" />
                <Button Content="{x:Static res:Strings.LibraryOpen}" Command="{Binding OpenLibraryCommand}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
            </WrapPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold" Margin="0,0,10,0"
                           Visibility="{Binding SelectionLabel, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{x:Static res:Strings.MultiSelectHint}" Style="{StaticResource Muted}" FontSize="11" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Foreground="SeaGreen" Margin="0,6,0,0"
                       Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
            <ListBox x:Name="ModList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch"
                     SelectionMode="Extended" b:MultiSelect.SelectedItems="{Binding SelectedMods}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ContextMenuOpening="OnContextMenuOpening"
                     AllowDrop="True" DragOver="OnFileDragOver" Drop="OnFileDrop">
                <!-- Submenus are filled in code-behind when the menu opens (see ModsView.xaml.cs). -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="AddMenu" Header="{x:Static res:Strings.AddToProfile}" />
                        <MenuItem x:Name="RemoveMenu" Header="{x:Static res:Strings.RemoveFromProfile}" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Strings.ShowOnMap}" Command="{Binding Selected.ShowOnMapCommand}" />
                        <MenuItem x:Name="MapInProfileMenu" Header="{x:Static res:Strings.ShowOnMapInProfile}" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Strings.LibraryMoveSelected}" Command="{Binding MoveToLibraryCommand}" />
                        <MenuItem Header="{x:Static res:Strings.LibraryMoveSelectedBack}" Command="{Binding MoveBackCommand}" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Strings.UninstallMods}" Command="{Binding UninstallCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ModItemViewModel">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="64" Height="38" Stretch="Uniform" HorizontalAlignment="Left"
                                   Source="{Binding IconFile, Converter={StaticResource PathToImage}, ConverterParameter=128}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ListSubtitle}" Style="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge}" Background="#4A6A8A" Margin="0,0,6,0"
                                        Visibility="{Binding InLibrary, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{x:Static res:Strings.LibraryBadge}" Style="{StaticResource BadgeText}" />
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="#B25E00" Margin="0,0,6,0"
                                        Visibility="{Binding IsDuplicate, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding DuplicateBadge}" Style="{StaticResource BadgeText}" />
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="#33808080" Margin="0,0,6,0"
                                        Visibility="{Binding HasType, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11" />
                                </Border>
                                <Border Style="{StaticResource Badge}"
                                        Background="{Binding CompatStatus, Converter={StaticResource CompatToBrush}}">
                                    <TextBlock Text="{Binding CompatLabel}" Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <v:ModDetailsView Grid.Column="1" DataContext="{Binding Selected}" />
    </Grid>
</UserControl>
