<Window x:Class="Dispatch.App.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Dispatch.App.Resources"
        xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:StatsViewModel}"
        Title="{Binding Title}" Width="1180" Height="880" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#30808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
        <DataTemplate x:Key="TileTemplate" DataType="vm:StatTile">
            <Border Style="{StaticResource Card}" Width="176">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Foreground="#C25A00" Margin="0,8,0,0"
                       Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.MapClose}" IsCancel="True" MinWidth="88" Click="OnClose" />
            <TextBlock Text="{x:Static res:Strings.StatsNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <Grid>
            <ProgressBar IsIndeterminate="True" Width="280" Height="6" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />

            <!-- One scrolling page: the tables fill what's left of a tall window (code-behind), and the whole page scrolls
                 in a small one. -->
            <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasStats, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <StackPanel x:Name="Summary">
                        <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="{Binding IncomeHeader}" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition x:Name="SkillsColumn" Width="290" MinWidth="220" MaxWidth="600" />
                            </Grid.ColumnDefinitions>
                            <GridSplitter x:Name="SkillsSplitter" Grid.Column="2" Style="{StaticResource PaneSplitter}" Margin="0,0,0,8" />

                            <!-- Revenue, costs, profit for the days the game keeps -->
                            <ItemsControl ItemsSource="{Binding Income}" ItemTemplate="{StaticResource TileTemplate}" />

                            <!-- One bar per day -->
                            <!-- The chart takes the width between the income tiles and the skills: bars share it evenly. -->
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,0,8">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:StatsDayBar">
                                                    <StackPanel Margin="1,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                                                        <!-- Bars shrink with narrow cells (at most 26 / 12 px wide). -->
                                                        <Grid Height="150" VerticalAlignment="Bottom">
                                                            <Rectangle Height="{Binding RevenueHeight}" MaxWidth="26" Margin="2,0" VerticalAlignment="Bottom"
                                                                       Fill="#5B8DD9" RadiusX="2" RadiusY="2" />
                                                            <Rectangle Height="{Binding ProfitHeight}" MaxWidth="12" Margin="4,0" VerticalAlignment="Bottom"
                                                                       Fill="#2E9E44" RadiusX="2" RadiusY="2" />
                                                        </Grid>
                                                        <Viewbox StretchDirection="DownOnly" Height="13">
                                                            <TextBlock Text="{Binding Label}" FontSize="10" Style="{StaticResource Muted}" />
                                                        </Viewbox>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Rectangle Width="12" Height="12" Fill="#5B8DD9" RadiusX="2" RadiusY="2" Margin="0,0,4,0" />
                                            <TextBlock Text="{x:Static res:Strings.StatRevenue}" FontSize="11" Margin="0,0,12,0" />
                                            <Rectangle Width="12" Height="12" Fill="#2E9E44" RadiusX="2" RadiusY="2" Margin="0,0,4,0" />
                                            <TextBlock Text="{x:Static res:Strings.StatProfit}" FontSize="11" Margin="0,0,12,0" />
                                            <TextBlock Text="{x:Static res:Strings.StatsDayAxis}" FontSize="11" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Skills -->
                            <StackPanel Grid.Column="3">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.StatsSkillsHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Skills}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:StatsSkillRow">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="22" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="6" Height="8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                <!-- Trucks, garages and drivers: sortable tables -->
                <TabControl x:Name="Tables" Height="360" Margin="0,8,0,0">
                    <!-- Every job the player finished (the game's delivery log), newest first, with totals above -->
                    <TabItem Header="{Binding JobsTab}">
                        <DockPanel>
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding JobTiles}" ItemTemplate="{StaticResource TileTemplate}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.JobsNone}" Style="{StaticResource Muted}" Margin="4,8"
                                       Visibility="{Binding HasJobs, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      CanUserReorderColumns="False" GridLinesVisibility="None" SelectionMode="Single" MinHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColFinished}" Binding="{Binding FinishedText}" SortMemberPath="Finished" Width="1.1*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColFrom}" Binding="{Binding From}" Width="2*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColTo}" Binding="{Binding To}" Width="2*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColCargo}" Binding="{Binding Cargo}" Width="1.5*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColMass}" Binding="{Binding MassText}" SortMemberPath="Mass" Width="0.7*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColKm}" Binding="{Binding KmText}" SortMemberPath="Km" Width="0.7*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColPayment}" Binding="{Binding PaymentText}" SortMemberPath="Payment" Width="1.1*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColPerKm}" Binding="{Binding PerKmText}" SortMemberPath="PerKm" Width="0.7*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColDamage}" Binding="{Binding DamageText}" SortMemberPath="Damage" Width="0.7*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColXp}" Binding="{Binding XpText}" SortMemberPath="Xp" Width="0.7*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColTruck}" Binding="{Binding Truck}" Width="1.3*" />
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColKind}" Binding="{Binding Kind}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{Binding TrucksTab}">
                        <DataGrid ItemsSource="{Binding Trucks}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  CanUserReorderColumns="False" GridLinesVisibility="None" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColModel}" Binding="{Binding Model}" Width="2*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColPlate}" Binding="{Binding Plate}" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColOdometer}" Binding="{Binding OdometerText}" SortMemberPath="Odometer" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColWear}" Binding="{Binding WearText}" SortMemberPath="Wear" Width="0.6*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColGarage}" Binding="{Binding Garage}" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColDriver}" Binding="{Binding Driver}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{Binding GaragesTab}">
                        <DataGrid ItemsSource="{Binding Garages}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  CanUserReorderColumns="False" GridLinesVisibility="None" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColCity}" Binding="{Binding City}" Width="2*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColSlots}" Binding="{Binding Slots}" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColTrucks}" Binding="{Binding Trucks}" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColDrivers}" Binding="{Binding Drivers}" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColRevenue}" Binding="{Binding RevenueText}" SortMemberPath="Revenue" Width="1.4*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColProfit}" Binding="{Binding ProfitText}" SortMemberPath="Profit" Width="1.4*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColProductivity}" Binding="{Binding ProductivityText}" SortMemberPath="Productivity" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{Binding DriversTab}">
                        <DataGrid ItemsSource="{Binding Drivers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  CanUserReorderColumns="False" GridLinesVisibility="None" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColGarage}" Binding="{Binding Garage}" Width="1.4*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColLevel}" Binding="{Binding Level}" Width="0.6*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColXp}" Binding="{Binding ExperienceText}" SortMemberPath="Experience" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.ColSkills}" Binding="{Binding Skills}" Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
