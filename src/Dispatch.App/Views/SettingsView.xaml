<UserControl x:Class="Dispatch.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Dispatch.App.Resources"
             xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <!-- DataContext: MainViewModel (needs both Settings and the Problems list). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Settings.DetectedHeader}" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static res:Strings.UserDataFolder}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Text="{Binding Settings.DetectedUserData, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.InstallFolder}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.DetectedInstall, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="2" Text="{x:Static res:Strings.GameVersion}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.DetectedVersion, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="3" Text="{x:Static res:Strings.SteamLibraries}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Libraries, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="4" Text="{x:Static res:Strings.SteamAccounts}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Accounts, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="5" Text="{x:Static res:Strings.OwnedDlc}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.Dlc, Mode=OneWay}" Style="{StaticResource FieldValue}" />
            </Grid>

            <TextBlock Text="{x:Static res:Strings.Problems}" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
            <TextBlock Text="{x:Static res:Strings.NoProblems}" Style="{StaticResource Muted}"
                       Visibility="{Binding HasProblems, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            <ItemsControl ItemsSource="{Binding Problems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="IndianRed" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Settings.OverridesHeader}" Style="{StaticResource SectionHeader}" Margin="0,20,0,4" />
            <TextBlock Text="{x:Static res:Strings.OverridesHint}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static res:Strings.InstallFolder}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Settings.InstallOverride, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                <Button Grid.Column="2" Content="{x:Static res:Strings.Browse}" Command="{Binding Settings.BrowseInstallCommand}" Margin="8,4,0,4" />
                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.UserDataFolder}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.UserDataOverride, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                <Button Grid.Row="1" Grid.Column="2" Content="{x:Static res:Strings.Browse}" Command="{Binding Settings.BrowseUserDataCommand}" Margin="8,4,0,4" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{x:Static res:Strings.SaveAndRedetect}" Command="{Binding Settings.SaveCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Content="{x:Static res:Strings.OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" />
                <Button Content="{x:Static res:Strings.OpenLogFolder}" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Settings.DataFolder}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />

            <TextBlock x:Name="VersionsSection" Text="{Binding Versions.Header}" Style="{StaticResource SectionHeader}" Margin="0,24,0,4" />
            <TextBlock Text="{x:Static res:Strings.VersionsHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding Versions.Items}" SelectedItem="{Binding Versions.Selected}" MaxHeight="220">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:InstallationItemViewModel">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="11" />
                            <TextBlock Text="{Binding Space}" Style="{StaticResource Muted}" FontSize="11"
                                       Visibility="{Binding HasSpace, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasDetail, Converter={StaticResource VisibleWhen}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="DarkOrange" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                <Setter Property="Foreground" Value="IndianRed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="{x:Static res:Strings.VersionsKeepCopy}" Command="{Binding Versions.KeepCopyCommand}" Margin="0,0,8,6" />
                <Button Content="{x:Static res:Strings.VersionsAddCopy}" Command="{Binding Versions.AddCopyCommand}" Margin="0,0,8,6" />
                <Button Content="{x:Static res:Strings.VersionsPack}" Command="{Binding Versions.PackCommand}" Margin="0,0,8,6" />
                <Button Content="{x:Static res:Strings.VersionsRemove}" Command="{Binding Versions.RemoveCommand}" Margin="0,0,8,6" />
                <Button Content="{x:Static res:Strings.VersionsOpenFolder}" Command="{Binding Versions.OpenFolderCommand}" Margin="0,0,8,6" />
            </WrapPanel>
            <DockPanel Margin="0,4,0,0" Visibility="{Binding Versions.IsCopying, Converter={StaticResource VisibleWhen}}">
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Cancel}" Command="{Binding Versions.CancelCopyCommand}" Margin="8,0,0,0" />
                <ProgressBar Value="{Binding Versions.CopyProgress}" Height="6" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Versions.CopyStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding Versions.CopyStatus, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{x:Static res:Strings.VersionsLaunchNote}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="{x:Static res:Strings.VersionsPackNote}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />

            <TextBlock Text="{x:Static res:Strings.FullBackupsHeader}" Style="{StaticResource SectionHeader}" Margin="0,24,0,4" />
            <TextBlock Text="{x:Static res:Strings.FullBackupsHint}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
            <TextBlock Text="{x:Static res:Strings.NoBackups}" Style="{StaticResource Muted}"
                       Visibility="{Binding Profiles.FullBackups.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            <ListBox ItemsSource="{Binding Profiles.FullBackups}" SelectedItem="{Binding Profiles.SelectedFullBackup}" MaxHeight="220"
                     Visibility="{Binding Profiles.FullBackups.Count, Converter={StaticResource VisibleWhen}}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:BackupItemViewModel">
                        <StackPanel Margin="0,2">
                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Backup.ProfileName, Mode=OneWay}" /> · <Run Text="{Binding When, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{Binding FilesLabel}" Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{x:Static res:Strings.RestoreFolder}" Command="{Binding Profiles.RestoreFolderCommand}" />
                <Button Content="{x:Static res:Strings.RecycleBackup}" Command="{Binding Profiles.RecycleFullBackupCommand}" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="{x:Static res:Strings.LanguageHeader}" Style="{StaticResource SectionHeader}" Margin="0,24,0,4" />
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Settings.Languages}" SelectedItem="{Binding Settings.SelectedLanguage}"
                          DisplayMemberPath="Name" MinWidth="220" />
                <TextBlock Text="{x:Static res:Strings.LanguageRestartHint}" VerticalAlignment="Center" Margin="12,0,8,0"
                           Visibility="{Binding Settings.RestartNeeded, Converter={StaticResource VisibleWhen}}" />
                <Button Content="{x:Static res:Strings.LanguageRestart}" Command="{Binding RestartCommand}"
                        Visibility="{Binding Settings.RestartNeeded, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.LanguageNote}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />

            <TextBlock Text="{x:Static res:Strings.UpdatesHeader}" Style="{StaticResource SectionHeader}" Margin="0,24,0,4" />
            <CheckBox IsChecked="{Binding Updates.AutoCheck}">
                <TextBlock Text="{x:Static res:Strings.UpdateAutoCheck}" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{x:Static res:Strings.UpdateCheckNow}" Command="{Binding Updates.CheckNowCommand}" />
                <TextBlock Text="{Binding Updates.Status}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{x:Static res:Strings.AboutHeader}" Style="{StaticResource SectionHeader}" Margin="0,24,0,4" />
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/dispatch.ico" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Top" />
                <StackPanel MaxWidth="760">
                    <TextBlock Text="{Binding Settings.AppVersion}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.AppSubtitle}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{x:Static res:Strings.AboutSafety}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{x:Static res:Strings.AboutLicence}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    <TextBlock Text="{x:Static res:Strings.AboutDisclaimer}" Style="{StaticResource Muted}" Margin="0,2,0,12" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
