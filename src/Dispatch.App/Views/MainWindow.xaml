<Window x:Class="Dispatch.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Dispatch.App.Resources"
        xmlns:v="clr-namespace:Dispatch.App.Views"
        xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{x:Static res:Strings.AppTitle}"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Icon="/Assets/dispatch.ico"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header: name, game version, refresh -->
        <Grid DockPanel.Dock="Top" Margin="20,14,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.AppTitle}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.AppSubtitle}" Style="{StaticResource Muted}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding GameVersion}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Style="{StaticResource Muted}" />
            <!-- The command disables the button while a refresh runs. -->
            <Button Grid.Column="2" Content="{x:Static res:Strings.LaunchGame}" Command="{Binding LaunchGameCommand}"
                    MinWidth="110" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}" />
            <Button Grid.Column="3" Content="{x:Static res:Strings.Refresh}" Command="{Binding RefreshCommand}"
                    MinWidth="96" VerticalAlignment="Center" />
        </Grid>

        <!-- Banners -->
        <Border DockPanel.Dock="Top" Background="#33E0A100" BorderBrush="#E0A100" BorderThickness="0,1"
                Padding="20,8" Visibility="{Binding IsGameRunning, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{x:Static res:Strings.GameRunning}" FontWeight="SemiBold" />
        </Border>
        <Border DockPanel.Dock="Top" Background="#22C62828" BorderBrush="#C62828" BorderThickness="0,1"
                Padding="20,8" Visibility="{Binding HasProblems, Converter={StaticResource VisibleWhen}}">
            <ItemsControl ItemsSource="{Binding Problems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Status bar -->
        <Grid DockPanel.Dock="Bottom" Margin="20,6,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
            <ProgressBar Grid.Column="1" Value="{Binding Progress}" Height="4" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Text="{x:Static res:Strings.ReadOnlyNotice}" Margin="20,0"
                   Style="{StaticResource Muted}" FontStyle="Italic" />

        <TabControl x:Name="Tabs" Margin="12,4,12,4">
            <TabItem Header="{x:Static res:Strings.TabProfiles}">
                <v:ProfilesView DataContext="{Binding Profiles}" />
            </TabItem>
            <TabItem Header="{x:Static res:Strings.TabMods}">
                <v:ModsView DataContext="{Binding Mods}" />
            </TabItem>
            <TabItem Header="{x:Static res:Strings.TabSettings}">
                <v:SettingsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
