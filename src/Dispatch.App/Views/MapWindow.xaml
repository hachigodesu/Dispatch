<Window x:Class="Dispatch.App.Views.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Dispatch.App.Resources"
        xmlns:v="clr-namespace:Dispatch.App.Views"
        xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MapViewModel}"
        Title="{Binding Title}" Width="1100" Height="800" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ComparedWith}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6" />
            <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:MapNote">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#C25A00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.MapClose}" IsCancel="True" MinWidth="88" Click="OnClose" />
            <TextBlock Text="{x:Static res:Strings.MapHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <!-- Legend and zoom buttons -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasMap, Converter={StaticResource VisibleWhen}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.MapZoomChanges}" Click="OnZoomChanges" Margin="0,0,6,0" />
                <Button Content="{x:Static res:Strings.MapWholeMap}" Click="OnZoomAll" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Rectangle Width="22" Height="4" Fill="#D9481E" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static res:Strings.MapLegendAdded}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Line X1="0" X2="22" Y1="2" Y2="2" Stroke="#2A6FDB" StrokeThickness="3" StrokeDashArray="2.5 2" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static res:Strings.MapLegendRemoved}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Rectangle Width="16" Height="12" Fill="#268E44AD" Stroke="#8E44AD" StrokeDashArray="2 1.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static res:Strings.MapLegendHidden}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Rectangle Width="22" Height="2" Fill="#9C9C9C" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static res:Strings.MapLegendOther}" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <v:MapCanvas x:Name="Map" Scene="{Binding Scene}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320"
                            Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,8" />
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}" Height="6" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
