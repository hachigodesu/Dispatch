<UserControl x:Class="Dispatch.App.Views.ModDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Dispatch.App.Resources"
             xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModItemViewModel}">
    <!-- DataContext: a ModItemViewModel (or null, which shows the placeholder). -->
    <Grid>
        <TextBlock Text="{x:Static res:Strings.ModDetailsNone}" Style="{StaticResource Muted}" Margin="4"
                   Visibility="{Binding Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Converter={StaticResource VisibleWhen}}">
            <StackPanel Margin="4,0,8,8">
                <Image Source="{Binding IconFile, Converter={StaticResource PathToImage}, ConverterParameter=276}"
                       Width="276" Height="162" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,10" />
                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PackageId}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" />
                <Border Style="{StaticResource Badge}" Background="{Binding CompatStatus, Converter={StaticResource CompatToBrush}}">
                    <TextBlock Text="{Binding CompatLabel}" Style="{StaticResource BadgeText}" />
                </Border>
                <TextBlock Text="{Binding CompatDetail}" TextWrapping="Wrap" Margin="0,6,0,4" />
                <Border Background="#224A6A8A" BorderBrush="#4A6A8A" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,4,0,4"
                        Visibility="{Binding InLibrary, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{x:Static res:Strings.LibraryDetail}" TextWrapping="Wrap" />
                </Border>
                <Border Background="#22B25E00" BorderBrush="#B25E00" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,4,0,4"
                        Visibility="{Binding IsDuplicate, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding DuplicateText}" TextWrapping="Wrap" />
                </Border>

                <Button Content="{x:Static res:Strings.ShowOnMap}" Command="{Binding ShowOnMapCommand}" HorizontalAlignment="Left"
                        Margin="0,6,0,0" ToolTip="{x:Static res:Strings.ShowOnMapHint}"
                        Visibility="{Binding LooksLikeMap, Converter={StaticResource VisibleWhen}}" />

                <TextBlock Text="{x:Static res:Strings.TagsLabel}" Style="{StaticResource Muted}" Margin="0,10,0,2" />
                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged, Delay=600}" ToolTip="{x:Static res:Strings.TagsHint}" />
                <TextBlock Text="{x:Static res:Strings.NoteLabel}" Style="{StaticResource Muted}" Margin="0,6,0,2" />
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged, Delay=600}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Author}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Author, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Version}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Version, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Categories}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Categories, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="3" Text="{x:Static res:Strings.CompatibleVersions}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CompatibleVersions, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="4" Text="{x:Static res:Strings.DlcDependencies}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DlcDependencies, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="5" Text="{x:Static res:Strings.Format}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FormatLabel, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="6" Text="{x:Static res:Strings.Size}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SizeLabel, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="7" Text="{x:Static res:Strings.Location}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Mod.Path, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                    <TextBlock Grid.Row="8" Text="{x:Static res:Strings.UsedIn}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding UsedInLabel, Mode=OneWay}" Style="{StaticResource FieldValue}" />
                </Grid>

                <TextBlock Text="{x:Static res:Strings.Issues}" Style="{StaticResource SectionHeader}" Margin="0,14,0,4"
                           Visibility="{Binding HasIssues, Converter={StaticResource VisibleWhen}}" />
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2"
                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static res:Strings.GameSays}" Style="{StaticResource SectionHeader}" Margin="0,14,0,0"
                           Visibility="{Binding HasGameMessages, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding GameMessagesHeader}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"
                           Visibility="{Binding HasGameMessages, Converter={StaticResource VisibleWhen}}" />
                <ItemsControl ItemsSource="{Binding GameMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2"
                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static res:Strings.Description}" Style="{StaticResource SectionHeader}" Margin="0,14,0,4"
                           Visibility="{Binding Description, Converter={StaticResource VisibleWhen}}" />
                <TextBox Text="{Binding Description, Mode=OneWay}" Style="{StaticResource FieldValue}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
