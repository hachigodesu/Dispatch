<UserControl x:Class="Dispatch.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Dispatch.App.Resources"
             xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HealthViewModel}">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.HealthRecheck}" Command="{Binding RecheckCommand}" />
            <StackPanel>
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static res:Strings.HealthHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,12,0" />
                <TextBlock Text="{x:Static res:Strings.HealthChecking}" Style="{StaticResource Muted}" FontStyle="Italic" Margin="0,2,0,0"
                           Visibility="{Binding IsChecking, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Foreground="SeaGreen" Margin="0,6,0,0"
                   Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProfileHealthItemViewModel">
                        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                            Background="{Binding IsHealthy, Converter={StaticResource BoolToBrush}, ConverterParameter=#2E7D32|#B25E00}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                        <Run Text="{Binding KindLabel, Mode=OneWay}" Foreground="Gray" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{x:Static res:Strings.HealthReadOnly}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                                           Visibility="{Binding IsReadOnly, Converter={StaticResource VisibleWhen}}" />
                                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:HealthIssueViewModel">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                                           Visibility="{Binding HasText, Converter={StaticResource VisibleWhen}}" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <Button Content="{Binding PrimaryLabel}" Command="{Binding Primary}" Margin="0,0,6,0"
                                                            Visibility="{Binding HasPrimary, Converter={StaticResource VisibleWhen}}" />
                                                    <Button Content="{Binding SecondaryLabel}" Command="{Binding Secondary}"
                                                            Visibility="{Binding HasSecondary, Converter={StaticResource VisibleWhen}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
