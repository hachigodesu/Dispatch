<Window x:Class="Dispatch.App.Views.SuggestOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Dispatch.App.Resources"
        xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SuggestionViewModel}"
        Title="{x:Static res:Strings.SuggestTitle}" Width="720" Height="640" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.SuggestRules}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
            <CheckBox Content="{x:Static res:Strings.SuggestOnlyMoved}" IsChecked="{Binding OnlyMoved}" Margin="0,10,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.SuggestApply}" IsDefault="True" MinWidth="120" Click="OnApply"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.SuggestNotSaved}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SuggestionRowViewModel">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                       Style="{StaticResource Muted}" />
                            <Image Grid.Column="1" Width="64" Height="38" Stretch="Uniform" HorizontalAlignment="Left"
                                   Source="{Binding IconFile, Converter={StaticResource PathToImage}, ConverterParameter=128}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMoved}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge}" Background="#33808080" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" />
                                </Border>
                                <Border Style="{StaticResource Badge}" MinWidth="72"
                                        Background="{Binding MovedUp, Converter={StaticResource BoolToBrush}, ConverterParameter=#2E7D32|#B25E00}"
                                        Visibility="{Binding IsMoved, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding MoveLabel}" Style="{StaticResource BadgeText}" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
