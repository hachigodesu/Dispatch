<Window x:Class="Dispatch.App.Views.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Dispatch.App.Resources"
        xmlns:vm="clr-namespace:Dispatch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ProfileDialogViewModel}"
        Title="{Binding Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static res:Strings.NewName}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
        <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="DarkOrange" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Duplicate-only options -->
        <StackPanel Visibility="{Binding IsDuplicate, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
            <TextBlock Text="{x:Static res:Strings.CopyWhat}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
            <RadioButton Content="{x:Static res:Strings.CopyEverything}" IsChecked="{Binding IncludeSaves}" GroupName="what" />
            <RadioButton Content="{x:Static res:Strings.CopyFresh}" GroupName="what"
                         IsChecked="{Binding IncludeSaves, Converter={StaticResource Not}}" />
            <CheckBox Content="{x:Static res:Strings.KeepWotLink}" IsChecked="{Binding KeepWorldOfTrucksLink}" Margin="0,8,0,0" />

            <StackPanel Visibility="{Binding CloudAvailable, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
                <TextBlock Text="{x:Static res:Strings.Destination}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                <RadioButton Content="{x:Static res:Strings.DestinationLocal}" GroupName="dest"
                             IsChecked="{Binding DestinationCloud, Converter={StaticResource Not}}" />
                <RadioButton Content="{x:Static res:Strings.DestinationCloud}" GroupName="dest" IsChecked="{Binding DestinationCloud}" />
                <TextBlock Text="{x:Static res:Strings.DestinationCloudHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding DestinationCloud, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static res:Strings.Ok}" IsDefault="True" MinWidth="88" IsEnabled="{Binding CanAccept}"
                    Click="OnOk" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
